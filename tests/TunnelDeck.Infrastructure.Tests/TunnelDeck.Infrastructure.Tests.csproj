<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/TunnelDeck.Infrastructure/TunnelDeck.Infrastructure.csproj" />
    <ProjectReference Include="../../test-infra/TunnelDeck.ProcessProbe/TunnelDeck.ProcessProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyProcessProbe" AfterTargets="Build">
    <ItemGroup>
      <ProcessProbeFile Include="$(MSBuildThisFileDirectory)../../test-infra/TunnelDeck.ProcessProbe/bin/$(Platform)/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessProbeFile)" DestinationFolder="$(OutDir)ProcessProbe" SkipUnchangedFiles="true" />
  </Target>
</Project>
