<UserControl x:Class="TunnelDeck.Controls.TransferPreviewItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TunnelDeck.Controls">
    <controls:ReadOnlyListItem AutomationProperties.Name="{x:Bind Item.Name, Mode=OneWay}">
        <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,0,0,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ResourceGlyph(Item), Mode=OneWay}" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Item.DisplayDescription, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind Item.DisplayDescription, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>
    </controls:ReadOnlyListItem>
</UserControl>
