<UserControl
    x:Class="TunnelDeck.Controls.TunnelListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages" xmlns:controls="using:TunnelDeck.Controls" SizeChanged="OnSizeChanged">
    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12">
    <Grid x:Name="RowLayout" ColumnSpacing="20" AutomationProperties.AutomationId="{x:Bind Item.AutomationId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.AccessibleName, Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="TunnelContent" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Item.ServerName, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Item.LeadingEndpoint, Mode=OneWay}" Style="{StaticResource TechnicalTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Visibility="{x:Bind pages:ShellPage.Visible(Item.PortAdjusted), Mode=OneWay}" Style="{ThemeResource SubtleButtonStyle}" Padding="4" MinWidth="28" MinHeight="28"
                        AutomationProperties.AutomationId="{x:Bind Item.AdjustmentId, Mode=OneWay}" AutomationProperties.Name="{Binding Values[TunnelListItem_PortAutomaticallyAdjusted], Source={StaticResource Strings}, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Item.Adjustment, Mode=OneWay}">
                    <InfoBadge Style="{StaticResource AttentionIconInfoBadgeStyle}"><InfoBadge.IconSource><FontIconSource Glyph="!" FontFamily="{ThemeResource ContentControlThemeFontFamily}" /></InfoBadge.IconSource></InfoBadge>
                    <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="320">
                        <TextBlock Text="{Binding Values[TunnelListItem_PortAdjusted], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Item.Adjustment, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                <TextBlock Grid.Column="2" Text="{x:Bind Item.TrailingEndpoint, Mode=OneWay}" Style="{StaticResource TechnicalTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Item.FullRoute, Mode=OneWay}" />
            </Grid>
            <TextBlock Text="{x:Bind Item.Error, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.Error), Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind Item.ReconnectMessage, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(Item.IsReconnecting), Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="{x:Bind Item.ReconnectId, Mode=OneWay}" />
            <TextBlock Text="{Binding Values[TunnelListItem_RequestFailedSeeDetails], Source={StaticResource Strings}, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.RequestError), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind Item.RequestError, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid x:Name="TunnelCommands" Grid.Column="1" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:StatusIndicator State="{x:Bind Item.StatusKey, Mode=OneWay}" Label="{x:Bind Item.Status, Mode=OneWay}" VerticalAlignment="Center" />
            <StackPanel x:Name="TunnelActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Style="{ThemeResource SubtleButtonStyle}" IsEnabled="{x:Bind Item.CanStop, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Hidden(Item.CanRetry), Mode=OneWay}"
                    AutomationProperties.AutomationId="{x:Bind Item.StopId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.StopName, Mode=OneWay}" ToolTipService.ToolTip="{Binding Values[TunnelListItem_StopForward], Source={StaticResource Strings}, Mode=OneWay}" Click="OnStop">
                <FontIcon Glyph="&#xE71A;" />
            </Button>
            <Button Content="{Binding Values[ResourceListView_Retry], Source={StaticResource Strings}, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(Item.CanRetry), Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind Item.RetryId, Mode=OneWay}" Click="OnRetry" />
            <Button Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="{x:Bind Item.DetailsId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.DetailsName, Mode=OneWay}" ToolTipService.ToolTip="{Binding Values[TunnelListItem_TunnelDetails], Source={StaticResource Strings}, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" />
                <Button.Flyout>
                    <Flyout x:Name="DetailsFlyout" Placement="Left" Opened="OnDetailsOpened" Closed="OnDetailsClosed">
                        <ScrollViewer MaxHeight="440" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10" MaxWidth="400">
                                <TextBlock Text="{x:Bind Item.ServerName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Item.Mode, Mode=OneWay}" />
                                <TextBlock Text="{Binding Values[TunnelListItem_Requested], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.RequestedRoute, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RequestedRoute" />
                                <TextBlock Text="{x:Bind Item.ActualLabel, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.FullRoute, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ActualRoute" />
                                <TextBlock Text="{Binding Values[TunnelListItem_Started], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Started, Mode=OneWay}" />
                                <TextBlock Text="{Binding Values[TunnelListItem_Duration], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Duration, Mode=OneWay}" AutomationProperties.AutomationId="TunnelDuration" />
                                <TextBlock Text="{Binding Values[TunnelListItem_StartedFrom], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Source, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="TunnelSource" />
                                <TextBlock Text="{x:Bind Item.ReconnectSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="TunnelReconnectSummary" />
                                <TextBlock Text="{x:Bind Item.ConnectionError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.ConnectionError), Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Item.RequestSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Item.RequestError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.RequestError), Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton Content="{Binding Values[RuleEditorView_Server], Source={StaticResource Strings}, Mode=OneWay}" IsEnabled="{x:Bind Item.CanOpenServer, Mode=OneWay}" Click="OnOpenServer" AutomationProperties.AutomationId="OpenTunnelServer" />
                                    <HyperlinkButton Content="{Binding Values[TunnelListItem_Profile], Source={StaticResource Strings}, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(Item.CanOpenProfile), Mode=OneWay}" Click="OnOpenProfile" AutomationProperties.AutomationId="OpenTunnelProfile" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="{x:Bind Item.MoreId, Mode=OneWay}" AutomationProperties.Name="{Binding Values[TunnelListItem_MoreTunnelActions], Source={StaticResource Strings}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Values[ResourceListView_MoreActions], Source={StaticResource Strings}, Mode=OneWay}">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem Text="{Binding Values[ResourceListView_Retry], Source={StaticResource Strings}, Mode=OneWay}" IsEnabled="{x:Bind Item.CanRetry, Mode=OneWay}" Click="OnRetry" />
                    <MenuFlyoutItem Text="{Binding Values[TunnelListItem_Remove], Source={StaticResource Strings}, Mode=OneWay}" IsEnabled="{x:Bind Item.CanRemove, Mode=OneWay}" Click="OnRemove" AutomationProperties.AutomationId="RemoveTunnel" />
                </MenuFlyout></Button.Flyout>
            </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</UserControl>
