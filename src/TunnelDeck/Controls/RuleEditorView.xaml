<UserControl x:Class="TunnelDeck.Controls.RuleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TunnelDeck.Controls" xmlns:pages="using:TunnelDeck.Pages">
    <StackPanel Spacing="12">
        <ComboBox x:Name="ServerSelector" Header="{Binding Values[RuleEditorView_Server], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="{Binding Values[RuleEditorView_SelectAServer], Source={StaticResource Strings}, Mode=OneWay}" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ServerChoices, Mode=OneWay}" DisplayMemberPath="ChoiceLabel" SelectionChanged="OnServerSelected"
                  AutomationProperties.AutomationId="RuleServer" AutomationProperties.Name="{Binding Values[RuleEditorView_RuleServer], Source={StaticResource Strings}, Mode=OneWay}" />
        <TextBlock Text="{x:Bind Model.ServerError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Model.ServerError), Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleServerError" />
        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind Model.ModeIndex, Mode=TwoWay}" AutomationProperties.Name="{Binding Values[RuleEditorView_RuleForwardingMode], Source={StaticResource Strings}, Mode=OneWay}">
            <RadioButton Content="{Binding Values[RuleEditorView_LocalForwarding], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="RuleLocalMode" />
            <RadioButton Content="{Binding Values[RuleEditorView_RemoteForwarding], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="RuleRemoteMode" />
        </RadioButtons>
        <TextBlock Text="{x:Bind Model.Direction, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox x:Name="LocalHostInput" Header="{x:Bind Model.LocalHostLabel, Mode=OneWay}" Text="{x:Bind Model.LocalHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RuleLocalHost" />
            <controls:PortInput x:Name="LocalPort" Grid.Column="1" Header="{Binding Values[RuleEditorView_LocalPort], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind Model.LocalPortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="RuleLocalPort" />
            <TextBlock Grid.Row="1" Text="{x:Bind Model.LocalHostError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleLocalHostError" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Model.LocalPortError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleLocalPortError" />
        </Grid>
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox x:Name="RemoteHostInput" Header="{x:Bind Model.RemoteHostLabel, Mode=OneWay}" Text="{x:Bind Model.RemoteHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RuleRemoteHost" />
            <controls:PortInput x:Name="RemotePort" Grid.Column="1" Header="{Binding Values[RuleEditorView_RemotePort], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind Model.RemotePortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="RuleRemotePort" />
            <TextBlock Grid.Row="1" Text="{x:Bind Model.RemoteHostError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleRemoteHostError" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Model.RemotePortError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleRemotePortError" />
        </Grid>
        <CheckBox Content="{Binding Values[RuleEditorView_FindNextAvailableLocalPortIfOccupied], Source={StaticResource Strings}, Mode=OneWay}" IsChecked="{x:Bind Model.AutoFindPort, Mode=TwoWay}"
                  Visibility="{x:Bind pages:ShellPage.Visible(Model.IsLocal), Mode=OneWay}" AutomationProperties.AutomationId="RuleAutoFindLocalPort" />
        <TextBlock Text="{Binding Values[RuleEditorView_IfRemoteListeningFailsEditThePortOr], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap"
                   Visibility="{x:Bind pages:ShellPage.Hidden(Model.IsLocal), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
