<UserControl x:Class="TunnelDeck.Controls.StatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Positive"><VisualState.Setters><Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Critical"><VisualState.Setters><Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Attention"><VisualState.Setters><Setter Target="StatusIcon.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" /></VisualState.Setters></VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <FontIcon x:Name="StatusIcon" Glyph="{x:Bind Glyph(State), Mode=OneWay}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Center" Visibility="{x:Bind pages:ShellPage.Visible(ShowLabel), Mode=OneWay}" />
    </StackPanel>
</UserControl>
