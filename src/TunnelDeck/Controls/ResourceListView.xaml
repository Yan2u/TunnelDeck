<UserControl x:Class="TunnelDeck.Controls.ResourceListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TunnelDeck.ViewModels" xmlns:pages="using:TunnelDeck.Pages" SizeChanged="OnControlSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/QuietCollectionResources.xaml" /></ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ResourceTemplate" x:DataType="vm:ResourceRow">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="4" MinHeight="148" Tag="{x:Bind}" ContextRequested="OnResourceContextRequested">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Tag="{x:Bind}" Click="OnOpenClick" Style="{ThemeResource SubtleButtonStyle}" Padding="12"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="{x:Bind RowAutomationId}" AutomationProperties.Name="{x:Bind AccessibleName}" ToolTipService.ToolTip="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" FontSize="16" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource MetadataTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <FontIcon Grid.Column="1" Glyph="&#xE784;" FontSize="14" Margin="0,12,8,0" VerticalAlignment="Top"
                                      Visibility="{x:Bind pages:ShellPage.Visible(IsPinned)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      ToolTipService.ToolTip="{Binding Values[ResourceListView_DragToReorder], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.Name="{Binding Values[ResourceListView_ReorderPinnedItem], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind DragAutomationId}" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="12,0,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind pages:ShellPage.TextVisible(Metadata)}">
                                <FontIcon Glyph="{x:Bind MetadataGlyph}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Metadata}" Style="{StaticResource MetadataTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Tag="{x:Bind}" Click="OnPinClick" Style="{ThemeResource SubtleButtonStyle}" IsEnabled="{x:Bind CanEdit}"
                                    ToolTipService.ToolTip="{x:Bind PinLabel}" AutomationProperties.AutomationId="{x:Bind PinAutomationId}" AutomationProperties.Name="{x:Bind PinAccessibleName}">
                                <FontIcon Glyph="{x:Bind PinGlyph}" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnMoreClick" Style="{ThemeResource SubtleButtonStyle}"
                                    AutomationProperties.AutomationId="{x:Bind MenuAutomationId}" AutomationProperties.Name="{x:Bind MenuAccessibleName}" ToolTipService.ToolTip="{Binding Values[ResourceListView_MoreActions], Source={StaticResource Strings}, Mode=OneWay}">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="PageContent" Padding="24" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="12">
            <CommandBar DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch" Background="{ThemeResource SubtleFillColorTransparentBrush}">
                <CommandBar.Content>
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="{x:Bind ViewModel.PageId, Mode=OneWay}" />
                </CommandBar.Content>
                <AppBarButton x:Name="AddResourceButton" Icon="Add" Label="{Binding Values[Common_Add], Source={StaticResource Strings}, Mode=OneWay}" Click="OnAddClick" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.AddLabel, Mode=OneWay}" AutomationProperties.AutomationId="AddResourceButton" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="{Binding Values[ImportPage_Import], Source={StaticResource Strings}, Mode=OneWay}" Icon="Import" Click="OnImportClick" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ImportResources" />
                    <AppBarButton Label="{Binding Values[ExportPage_Export], Source={StaticResource Strings}, Mode=OneWay}" Icon="SaveLocal" Click="OnExportClick" IsEnabled="{x:Bind ViewModel.CanDeleteAll, Mode=OneWay}" AutomationProperties.AutomationId="ExportResources" />
                    <AppBarSeparator />
                    <AppBarButton Label="{x:Bind ViewModel.DeleteAllLabel, Mode=OneWay}" Icon="Delete" Click="OnDeleteAllClick"
                                  IsEnabled="{x:Bind ViewModel.CanDeleteAll, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind ViewModel.DeleteAllId, Mode=OneWay}" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(ViewModel.TransferNotice), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.TransferNotice), Mode=OneWay}"
                     Severity="Warning" Message="{x:Bind ViewModel.TransferNotice, Mode=OneWay}" Closed="OnTransferNoticeClosed" AutomationProperties.AutomationId="ImportResultNotice" />
            <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(ViewModel.OperationError), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.OperationError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" Severity="Error" IsClosable="False" AutomationProperties.AutomationId="ResourceOrderError">
                <InfoBar.ActionButton><Button Content="{Binding Values[ResourceListView_Retry], Source={StaticResource Strings}, Mode=OneWay}" Click="OnRetryChange" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RetryResourceChange" /></InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Grid x:Name="ResourceViewport" Grid.Row="1" SizeChanged="OnViewportSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                        Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.ShowEmpty), Mode=OneWay}" Spacing="16">
                <FontIcon Glyph="&#xE8F1;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                <Button Content="{x:Bind ViewModel.AddLabel, Mode=OneWay}" Click="OnAddClick" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="EmptyAddResource" />
            </StackPanel>
            <Grid x:Name="PinnedSection" MaxHeight="280" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.HasPinned), Mode=OneWay}" Margin="0,0,0,16" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.PinnedLabel, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="PinnedHeading" />
                <GridView x:Name="PinnedList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Pinned, Mode=OneWay}" ItemTemplate="{StaticResource ResourceTemplate}"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsStarting="OnPinnedDragStarting" DragItemsCompleted="OnPinnedDragCompleted" DragOver="OnPinnedDragOver" Drop="OnPinnedDrop"
                          IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" ItemContainerStyle="{StaticResource ResourceCardContainerStyle}" SelectionMode="Single"
                          IsItemClickEnabled="False" Loaded="OnCollectionLoaded" SizeChanged="OnCollectionSizeChanged"
                          ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PinnedResources">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" /></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView>
            </Grid>
            <Grid Grid.Row="1" RowSpacing="12" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.HasOther), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.OtherLabel, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OtherHeading" />
                <GridView x:Name="OtherList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Other, Mode=OneWay}" ItemTemplate="{StaticResource ResourceTemplate}" AllowDrop="True" DragOver="RejectDrop" Drop="RejectDrop"
                          IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" ItemContainerStyle="{StaticResource ResourceCardContainerStyle}" SelectionMode="None" IsItemClickEnabled="False"
                          Loaded="OnCollectionLoaded" SizeChanged="OnCollectionSizeChanged"
                          ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="OtherResources">
                    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="320" /></ItemsPanelTemplate></GridView.ItemsPanel>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
