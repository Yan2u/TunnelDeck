<pages:ShellPage x:Class="TunnelDeck.Pages.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages" SizeChanged="OnPageSizeChanged">
    <pages:ShellPage.Resources><ResourceDictionary Source="../Themes/QuietCollectionResources.xaml" /></pages:ShellPage.Resources>
    <Grid x:Name="PageContent" Padding="24" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" Background="{ThemeResource SubtleFillColorTransparentBrush}">
            <CommandBar.Content>
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="ServerDetailPage" />
            </CommandBar.Content>
            <AppBarButton Label="{x:Bind ViewModel.TestActionLabel, Mode=OneWay}" Click="OnTestClick" IsEnabled="{x:Bind ViewModel.CanTestAction, Mode=OneWay}"
                          AutomationProperties.AutomationId="TestConnection">
                <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="Save" Label="{Binding Values[Common_Save], Source={StaticResource Strings}, Mode=OneWay}" Click="OnSaveClick" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                          AutomationProperties.AutomationId="SaveServer" AutomationProperties.Name="{Binding Values[ServerDetailPage_SaveServer], Source={StaticResource Strings}, Mode=OneWay}" />
            <AppBarButton Icon="Cancel" Label="{Binding Values[DeletionDialog_Cancel], Source={StaticResource Strings}, Mode=OneWay}" Click="OnCancelClick" AutomationProperties.AutomationId="CancelServer" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="{Binding Values[DashboardPage_OpenTerminal], Source={StaticResource Strings}, Mode=OneWay}" Click="OnTerminalClick" IsEnabled="{x:Bind ViewModel.CanOpenTerminal, Mode=OneWay}"
                              ToolTipService.ToolTip="{Binding Values[ServerDetailPage_SaveConnectionChangesFirstOpensASeparateSSH], Source={StaticResource Strings}, Mode=OneWay}"
                              AutomationProperties.AutomationId="OpenServerTerminal">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE756;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="{Binding Values[Common_DeleteServer], Source={StaticResource Strings}, Mode=OneWay}" Icon="Delete" Click="OnDeleteClick" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AutomationId="DeleteServer" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ServerDetailScroll">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <InfoBar IsOpen="{x:Bind ViewModel.HasTestResult, Mode=OneWay}" IsClosable="False"
                         Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.HasTestResult), Mode=OneWay}"
                         Title="{x:Bind ViewModel.TestTitle, Mode=OneWay}" Message="{x:Bind ViewModel.TestMessage, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.TestSeverity, Mode=OneWay}" AutomationProperties.AutomationId="ConnectionTestStatus">
                    <StackPanel Spacing="8">
                        <ProgressRing Width="20" Height="20" HorizontalAlignment="Left" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}"
                                      Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsTesting), Mode=OneWay}" AutomationProperties.Name="{Binding Values[ServerDetailPage_ConnectionTestInProgress], Source={StaticResource Strings}, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.Fingerprint), Mode=OneWay}" AutomationProperties.AutomationId="VerifiedFingerprint" />
                    </StackPanel>
                </InfoBar>
                <TextBlock Text="{Binding Values[ServerDetailPage_ThisServerIsInUseStopItsTunnels], Source={StaticResource Strings}, Mode=OneWay}"
                           Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsServerInUse), Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ServerInUseNotice" />
                <StackPanel Spacing="4">
                    <TextBox x:Name="DisplayNameInput" Header="{Binding Values[ServerDetailPage_DisplayName], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="{Binding Values[ServerDetailPage_OptionalDefaultsToHost], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.CanEditName, Mode=OneWay}" AutomationProperties.AutomationId="ServerDisplayName" />
                    <TextBlock Text="{x:Bind ViewModel.DisplayNameError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.DisplayNameError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ServerDisplayNameError" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBox Header="{Binding Values[ServerDetailPage_HostIP], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="dev.example.com" Text="{x:Bind ViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="ServerHost" />
                        <TextBlock Text="{x:Bind ViewModel.HostError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.HostError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ServerHostError" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBox Header="{Binding Values[ServerDetailPage_SSHPort], Source={StaticResource Strings}, Mode=OneWay}" InputScope="Number" Text="{x:Bind ViewModel.PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="ServerPort" />
                        <TextBlock Text="{x:Bind ViewModel.PortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.PortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ServerPortError" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBox Header="{Binding Values[ServerDetailPage_Username], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="{Binding Values[ServerDetailPage_YourSSHUsername], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="ServerUsername" />
                    <TextBlock Text="{x:Bind ViewModel.UsernameError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.UsernameError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ServerUsernameError" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ComboBox Header="{Binding Values[ServerDetailPage_AuthenticationMethod], Source={StaticResource Strings}, Mode=OneWay}" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.AuthenticationIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="AuthenticationMethod">
                    <ComboBoxItem Content="{Binding Values[ServerDetailPage_Password], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="PasswordAuthentication">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Values[ServerDetailPage_Password], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                    <ComboBoxItem Content="{Binding Values[ServerDetailPage_PrivateKeyIdentityFile], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="PrivateKeyAuthentication">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Values[ServerDetailPage_PrivateKeyIdentityFile], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                </ComboBox>
                <StackPanel Spacing="8" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsPrivateKey), Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Header="{Binding Values[ServerDetailPage_IdentityFilePath], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="C:\Keys\id_ed25519" Text="{x:Bind ViewModel.IdentityFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="IdentityFilePath" />
                        <Button Grid.Column="1" Content="{Binding Values[ImportPage_Browse], Source={StaticResource Strings}, Mode=OneWay}" VerticalAlignment="Bottom" Click="OnBrowseClick"
                                IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="BrowseIdentityFile" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.KeyPathError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.KeyPathError), Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="IdentityFileError" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Values[ServerDetailPage_YourPrivateKeyStaysOnThisComputerOnly], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Spacing="8">
                    <PasswordBox Header="{x:Bind ViewModel.SecretLabel, Mode=OneWay}" Password="{x:Bind ViewModel.Secret, Mode=TwoWay}" PasswordRevealMode="Peek"
                                 IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="ServerSecret" />
                    <TextBlock Text="{x:Bind ViewModel.CredentialError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.CredentialError), Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="CredentialError" AutomationProperties.LiveSetting="Polite" />
                    <CheckBox Content="{Binding Values[ServerDetailPage_RememberInWindowsCredentialManager], Source={StaticResource Strings}, Mode=OneWay}" IsChecked="{x:Bind ViewModel.RememberCredential, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.CanEditIdentity, Mode=OneWay}" AutomationProperties.AutomationId="RememberCredential" />
                    <TextBlock Text="{x:Bind ViewModel.SecretHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Values[ServerDetailPage_PreviewDataDoesNotOpenNetworkConnectionsLaunch], Source={StaticResource Strings}, Mode=OneWay}"
                           Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsPreview), Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</pages:ShellPage>
