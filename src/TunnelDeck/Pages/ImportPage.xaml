<pages:ShellPage x:Class="TunnelDeck.Pages.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages" xmlns:vm="using:TunnelDeck.ViewModels"
    xmlns:controls="using:TunnelDeck.Controls" SizeChanged="OnPageSizeChanged">
    <Grid x:Name="PageContent" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Values[ImportPage_Import], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="ImportPage" />
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="{Binding Values[ImportPage_AboutImporting], Source={StaticResource Strings}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Values[ImportPage_AboutImporting], Source={StaticResource Strings}, Mode=OneWay}">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
                <Button.Flyout><Flyout><TextBlock MaxWidth="360" TextWrapping="Wrap"
                    Text="{Binding Values[ImportPage_ExistingNamesAreKeptAsSeparateEntriesExpand], Source={StaticResource Strings}, Mode=OneWay}" /></Flyout></Button.Flyout>
            </Button>
        </Grid>
        <!-- Keep file inputs outside the virtualized preview so refreshes cannot steal their focus. -->
        <ScrollViewer x:Name="ImportFormScroll" Grid.Row="1" MaxHeight="220" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ImportForm">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="ImportFileInput" Header="{Binding Values[ImportPage_File], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="{Binding Values[ImportPage_EnterTheFullPathOrBrowse], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind ViewModel.FilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="0" KeyDown="OnFileKeyDown" ToolTipService.ToolTip="{Binding Values[ImportPage_EnterAFilePathPressEnterToReload], Source={StaticResource Strings}, Mode=OneWay}"
                         IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}" AutomationProperties.AutomationId="ImportFilePath" />
                <ComboBox x:Name="SourceSelector" Grid.Column="1" VerticalAlignment="Bottom" SelectedIndex="{x:Bind ViewModel.SourceIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}" MinWidth="0" Width="128" AutomationProperties.Name="{Binding Values[ImportPage_FileFormat], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="ImportFormat">
                    <ComboBoxItem Content="JSON" AutomationProperties.AutomationId="ImportJsonFormat" />
                    <ComboBoxItem Content="{Binding Values[ImportPage_SSHConfig], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="ImportSshFormat">
                        <ComboBoxItem.ContentTemplate>
                            <DataTemplate><TextBlock Text="{Binding Values[ImportPage_SSHConfig], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                        </ComboBoxItem.ContentTemplate>
                    </ComboBoxItem>
                </ComboBox>
                <Button Grid.Column="2" Content="{Binding Values[ImportPage_Browse], Source={StaticResource Strings}, Mode=OneWay}" VerticalAlignment="Bottom" Click="OnBrowseClick" IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}" AutomationProperties.AutomationId="BrowseImport" />
            </Grid>
        </ScrollViewer>
        <ScrollViewer Grid.Row="2" IsTabStop="True" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ImportPreview" AutomationProperties.Name="{Binding Values[ImportPage_ImportPreview], Source={StaticResource Strings}, Mode=OneWay}">
            <StackPanel Spacing="12">
                <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(ViewModel.Error), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.Error), Mode=OneWay}"
                         Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" IsClosable="False" AutomationProperties.AutomationId="ImportError">
                    <InfoBar.ActionButton><Button Content="{Binding Values[ResourceListView_Retry], Source={StaticResource Strings}, Mode=OneWay}" Click="OnRetryPreviewClick" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.CanRetryPreview), Mode=OneWay}" /></InfoBar.ActionButton>
                </InfoBar>
                <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(ViewModel.Warnings), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.Warnings), Mode=OneWay}"
                         Message="{x:Bind ViewModel.Warnings, Mode=OneWay}" Severity="Warning" IsClosable="False" AutomationProperties.AutomationId="ImportWarnings" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                           Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.Summary), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ImportSummary" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" AutomationProperties.AutomationId="ImportItems">
                    <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:ImportPreviewEntry"><controls:ImportPreviewItem Entry="{x:Bind}" /></DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.ActionHint, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.ActionHint), Mode=OneWay}" AutomationProperties.AutomationId="ImportActionHint" AutomationProperties.LiveSetting="Polite" />
            <CheckBox IsChecked="{x:Bind ViewModel.SkipUnavailable, Mode=TwoWay}" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.HasSkipped), Mode=OneWay}"
                      IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}" AutomationProperties.AutomationId="SkipUnavailableImports">
                <TextBlock Text="{x:Bind ViewModel.SkipLabel, Mode=OneWay}" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind ViewModel.ImportLabel, Mode=OneWay}" Click="OnImportClick" Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}" AutomationProperties.AutomationId="CommitImport" />
                <Button Content="{Binding Values[DeletionDialog_Cancel], Source={StaticResource Strings}, Mode=OneWay}" Click="OnCancelClick" IsEnabled="{x:Bind ViewModel.CanChooseFile, Mode=OneWay}" AutomationProperties.AutomationId="CancelImport" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsBusy), Mode=OneWay}" Width="20" Height="20"
                              AutomationProperties.Name="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" AutomationProperties.AutomationId="ImportProgress" />
            </StackPanel>
        </StackPanel>
    </Grid>
</pages:ShellPage>
