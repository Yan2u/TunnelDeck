<pages:ShellPage x:Class="TunnelDeck.Pages.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages" xmlns:transfer="using:TunnelDeck.Core.Transfer" xmlns:controls="using:TunnelDeck.Controls" SizeChanged="OnPageSizeChanged">
    <Grid x:Name="PageContent" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{Binding Values[ExportPage_Export], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="ExportPage" />
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ExportPreview">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="12">
                        <ComboBox Header="{Binding Values[Common_Resources], Source={StaticResource Strings}, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.ScopeIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChooseScope, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ExportScope">
                            <ComboBoxItem Content="{Binding Values[ExportPage_ServersOnly], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="ExportServersScope">
                                <ComboBoxItem.ContentTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Values[ExportPage_ServersOnly], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                                </ComboBoxItem.ContentTemplate>
                            </ComboBoxItem>
                            <ComboBoxItem Content="{Binding Values[ExportPage_ProfilesAndRequiredServers], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="ExportProfilesScope">
                                <ComboBoxItem.ContentTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Values[ExportPage_ProfilesAndRequiredServers], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                                </ComboBoxItem.ContentTemplate>
                            </ComboBoxItem>
                            <ComboBoxItem Content="{Binding Values[ExportPage_AllServersAndProfiles], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="ExportAllScope">
                                <ComboBoxItem.ContentTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Values[ExportPage_AllServersAndProfiles], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                                </ComboBoxItem.ContentTemplate>
                            </ComboBoxItem>
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Values[ExportPage_TunnelDeckJSONCredentialsExcluded], Source={StaticResource Strings}, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="{Binding Values[ExportPage_AboutThisExport], Source={StaticResource Strings}, Mode=OneWay}" ToolTipService.ToolTip="{Binding Values[ExportPage_AboutThisExport], Source={StaticResource Strings}, Mode=OneWay}">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <Button.Flyout><Flyout><TextBlock MaxWidth="360" TextWrapping="Wrap"
                                    Text="{Binding Values[ExportPage_ProfilesIncludeTheirRequiredServersAndResourceOrder], Source={StaticResource Strings}, Mode=OneWay}" /></Flyout></Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(ViewModel.Error), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.Error), Mode=OneWay}"
                         Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" IsClosable="False" AutomationProperties.AutomationId="ExportError" />
                <TextBlock Text="{x:Bind ViewModel.SavedPath, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(ViewModel.SavedPath), Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ExportSavedPath" />
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ExportSummary" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout><StackLayout /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="transfer:ImportItem"><controls:TransferPreviewItem Item="{x:Bind}" /></DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding Values[ExportPage_ChooseFileAndExport], Source={StaticResource Strings}, Mode=OneWay}" Click="OnExportClick" Style="{ThemeResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" AutomationProperties.AutomationId="SaveExport" />
            <Button Content="{Binding Values[Shell_Back], Source={StaticResource Strings}, Mode=OneWay}" Click="OnBackClick" IsEnabled="{x:Bind ViewModel.CanChooseScope, Mode=OneWay}" AutomationProperties.AutomationId="CancelExport" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.IsBusy), Mode=OneWay}" Width="20" Height="20" AutomationProperties.Name="{Binding Values[ExportPage_ExportInProgress], Source={StaticResource Strings}, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</pages:ShellPage>
