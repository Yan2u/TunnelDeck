<pages:ShellPage
    x:Class="TunnelDeck.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages"
    xmlns:controls="using:TunnelDeck.Controls"
    xmlns:presentation="using:TunnelDeck.Core.Presentation"
    SizeChanged="OnPageSizeChanged">
    <pages:ShellPage.Resources><ResourceDictionary Source="../Themes/QuietCollectionResources.xaml" /></pages:ShellPage.Resources>
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="DashboardScroll">
        <Grid x:Name="DashboardViewport">
            <StackPanel x:Name="PageContent" Padding="24" Spacing="24" MaxWidth="1320" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Values[MainWindow_Dashboard], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="DashboardPage" />
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                    <StackPanel x:Name="QuickForm" Spacing="12" SizeChanged="OnQuickFormSizeChanged">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Values[DashboardPage_QuickForward], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                            <Button Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="{Binding Values[DashboardPage_ForwardingHelp], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="QuickHelp" ToolTipService.ToolTip="{Binding Values[DashboardPage_ForwardingHelp], Source={StaticResource Strings}, Mode=OneWay}">
                                <FontIcon Glyph="&#xE946;" FontSize="16" />
                                <Button.Flyout><Flyout><StackPanel Spacing="12" MaxWidth="340">
                                    <TextBlock Text="{x:Bind Shell.Quick.Direction, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Values[DashboardPage_LocalListensOnThisPCAndReachesA], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Values[DashboardPage_AdvancedLetsYouSetDifferentPortsAndHosts], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Values[DashboardPage_RunningMeansTheListenerIsReadyTheTarget], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel></Flyout></Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid x:Name="QuickFields" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="ServerField" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="QuickServer" Header="{Binding Values[RuleEditorView_Server], Source={StaticResource Strings}, Mode=OneWay}" PlaceholderText="{Binding Values[RuleEditorView_SelectAServer], Source={StaticResource Strings}, Mode=OneWay}" HorizontalAlignment="Stretch" MinWidth="0"
                                          ItemsSource="{x:Bind Shell.ServerChoices, Mode=OneWay}" DisplayMemberPath="ChoiceLabel" SelectionChanged="OnServerSelected"
                                          IsEnabled="{x:Bind Shell.IsReady, Mode=OneWay}" AutomationProperties.AutomationId="QuickServer" AutomationProperties.Name="{Binding Values[DashboardPage_QuickForwardServer], Source={StaticResource Strings}, Mode=OneWay}" />
                                <Button x:Name="QuickPin" Grid.Column="1" VerticalAlignment="Bottom" Style="{ThemeResource SubtleButtonStyle}" Click="OnQuickPinClick"
                                        AutomationProperties.AutomationId="QuickPin" AutomationProperties.Name="{Binding Values[DashboardPage_PinThisServerForQuickForward], Source={StaticResource Strings}, Mode=OneWay}"><FontIcon x:Name="QuickPinIcon" Glyph="&#xE718;" /></Button>
                            </Grid>
                            <Grid x:Name="ForwardFields" Grid.Column="1" ColumnSpacing="12" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ForwardModeSelector" Header="{Binding Values[DashboardPage_Forwarding], Source={StaticResource Strings}, Mode=OneWay}" Width="144" MinWidth="0" HorizontalAlignment="Stretch"
                                          SelectedIndex="{x:Bind Shell.Quick.ModeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="ForwardModeSelector" AutomationProperties.Name="{Binding Values[DashboardPage_ForwardingMode], Source={StaticResource Strings}, Mode=OneWay}">
                                    <ComboBoxItem Content="{Binding Values[DashboardPage_Local], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="QuickLocalMode">
                                        <ComboBoxItem.ContentTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Values[DashboardPage_Local], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                                        </ComboBoxItem.ContentTemplate>
                                    </ComboBoxItem>
                                    <ComboBoxItem Content="{Binding Values[DashboardPage_Remote], Source={StaticResource Strings}, Mode=OneWay}" AutomationProperties.AutomationId="QuickRemoteMode">
                                        <ComboBoxItem.ContentTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Values[DashboardPage_Remote], Source={StaticResource Strings}, Mode=OneWay}" /></DataTemplate>
                                        </ComboBoxItem.ContentTemplate>
                                    </ComboBoxItem>
                                </ComboBox>
                                <controls:PortInput x:Name="QuickPort" Grid.Column="1" Header="{Binding Values[DashboardPage_Port], Source={StaticResource Strings}, Mode=OneWay}" Width="128" Text="{x:Bind Shell.Quick.PortText, Mode=TwoWay}"
                                                    IsEnabled="{x:Bind Shell.Quick.UseSamePort, Mode=OneWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickPort" />
                                <Button x:Name="ForwardButton" Grid.Column="2" Content="{Binding Values[DashboardPage_Forward], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"
                                        IsEnabled="{x:Bind Shell.Quick.CanStart, Mode=OneWay}" Click="OnForwardClick" AutomationProperties.AutomationId="ForwardButton" />
                            </Grid>
                        </Grid>
                        <TextBlock Text="{x:Bind Shell.Quick.PortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.PortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickPortError" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{x:Bind Shell.Quick.ServerError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.ServerError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                        <Grid x:Name="OptionsRow" ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <CheckBox x:Name="AutoFindPort" Content="{Binding Values[DashboardPage_FindAnAvailablePort], Source={StaticResource Strings}, Mode=OneWay}" VerticalAlignment="Center" IsChecked="{x:Bind Shell.Quick.AutoFindPort, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{Binding Values[DashboardPage_UseTheNextAvailableLocalPortIfThe], Source={StaticResource Strings}, Mode=OneWay}"
                                      Visibility="{x:Bind pages:ShellPage.Visible(Shell.Quick.IsLocal), Mode=OneWay}" AutomationProperties.AutomationId="AutoFindLocalPort" />
                            <ToggleSwitch x:Name="AdvancedToggle" Grid.Column="1" OnContent="{Binding Values[DashboardPage_Advanced], Source={StaticResource Strings}, Mode=OneWay}" OffContent="{Binding Values[DashboardPage_Advanced], Source={StaticResource Strings}, Mode=OneWay}" MinWidth="0" VerticalAlignment="Center"
                                          IsOn="{x:Bind Shell.Quick.UseAdvanced, Mode=TwoWay}" AutomationProperties.AutomationId="QuickAdvanced" AutomationProperties.Name="{Binding Values[DashboardPage_AdvancedForwardingOptions], Source={StaticResource Strings}, Mode=OneWay}"
                                          ToolTipService.ToolTip="{Binding Values[DashboardPage_SetDifferentLocalAndRemoteHostsOrPorts], Source={StaticResource Strings}, Mode=OneWay}" />
                            <Button x:Name="QuickOpenTerminal" Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}" VerticalAlignment="Center" Click="OnTerminalClick"
                                    IsEnabled="False" AutomationProperties.AutomationId="OpenQuickTerminal" AutomationProperties.Name="{Binding Values[DashboardPage_OpenTerminal], Source={StaticResource Strings}, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding Values[DashboardPage_OpensASeparateSSHSessionSignInAnd], Source={StaticResource Strings}, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE756;" FontSize="16" />
                                    <TextBlock Text="{Binding Values[DashboardPage_OpenTerminal], Source={StaticResource Strings}, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid x:Name="AdvancedFields" x:Load="{x:Bind Shell.Quick.UseAdvanced, Mode=OneWay}" ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBox Header="{x:Bind Shell.Quick.LocalHostLabel, Mode=OneWay}" Text="{x:Bind Shell.Quick.LocalHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="QuickLocalHost" />
                            <controls:PortInput x:Name="LocalPort" Grid.Column="1" Header="{Binding Values[RuleEditorView_LocalPort], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind Shell.Quick.LocalPortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickLocalPort" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Text="{x:Bind Shell.Quick.LocalHostError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.LocalHostError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickLocalHostError" />
                                <TextBlock Text="{x:Bind Shell.Quick.LocalPortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.LocalPortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickLocalPortError" />
                            </StackPanel>
                            <TextBox Grid.Row="2" Header="{x:Bind Shell.Quick.RemoteHostLabel, Mode=OneWay}" Text="{x:Bind Shell.Quick.RemoteHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="QuickRemoteHost" />
                            <controls:PortInput x:Name="RemotePort" Grid.Row="2" Grid.Column="1" Header="{Binding Values[RuleEditorView_RemotePort], Source={StaticResource Strings}, Mode=OneWay}" Text="{x:Bind Shell.Quick.RemotePortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickRemotePort" />
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="{x:Bind Shell.Quick.RemoteHostError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.RemoteHostError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickRemoteHostError" />
                                <TextBlock Text="{x:Bind Shell.Quick.RemotePortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.RemotePortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickRemotePortError" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="NoServerHint" Spacing="8">
                            <TextBlock Text="{Binding Values[DashboardPage_AddAnSSHServerToStartForwarding], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton Content="{Binding Values[DashboardPage_AddServer], Source={StaticResource Strings}, Mode=OneWay}" Click="OnAddServerClick" HorizontalAlignment="Left" Padding="0" IsEnabled="{x:Bind Shell.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="DashboardAddServer" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(Shell.Forwarding.CommandError), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Forwarding.CommandError), Mode=OneWay}" Message="{x:Bind Shell.Forwarding.CommandError, Mode=OneWay}" Severity="Error" Closed="OnCommandErrorClosed" AutomationProperties.AutomationId="ForwardCommandError" />
                <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(Shell.Forwarding.ActivityError), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Forwarding.ActivityError), Mode=OneWay}" Message="{x:Bind Shell.Forwarding.ActivityError, Mode=OneWay}" Severity="Warning" IsClosable="False" AutomationProperties.AutomationId="ActivitySaveError">
                    <InfoBar.ActionButton><Button Content="{Binding Values[DashboardPage_RetrySaving], Source={StaticResource Strings}, Mode=OneWay}" Click="OnRetryActivity" /></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Values[DashboardPage_ActiveTunnels], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Shell.RuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ActiveCount" />
                        <Button Grid.Column="2" Content="{Binding Values[DashboardPage_StopAll], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource SubtleButtonStyle}" IsEnabled="{x:Bind Shell.Forwarding.CanStopAll, Mode=OneWay}" Click="OnStopAll" AutomationProperties.AutomationId="StopAllTunnels" />
                    </Grid>
                    <StackPanel x:Name="EmptyTunnels" Spacing="12" Orientation="Horizontal" Padding="12,20">
                        <FontIcon Glyph="&#xE839;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Values[DashboardPage_NoActiveTunnels], Source={StaticResource Strings}, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="ActiveList" ItemsSource="{x:Bind Shell.Tunnels, Mode=OneWay}" SelectionMode="None" MaxHeight="360" ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                              ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ActiveTunnelList">
                        <ListView.ItemTemplate><DataTemplate x:DataType="presentation:TunnelItem">
                            <controls:TunnelListItem Item="{x:Bind}" HorizontalAlignment="Stretch" StopRequested="OnStopTunnel" RetryRequested="OnRetryTunnel" RemoveRequested="OnRemoveTunnel"
                                                     DetailsRefreshRequested="OnDetailsRefresh" OpenServerRequested="OnOpenTunnelServer" OpenProfileRequested="OnOpenTunnelProfile" />
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
                <Grid x:Name="RecentAndStatistics" ColumnSpacing="32" RowSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="RecentSection" Spacing="16">
                        <TextBlock Text="{Binding Values[DashboardPage_RecentActivity], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="RecentHeading" />
                        <TextBlock x:Name="EmptyRecent" Text="{Binding Values[DashboardPage_NoRecentActivity], Source={StaticResource Strings}, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}" SelectionMode="None" MaxHeight="420"
                                  ItemContainerStyle="{StaticResource StretchListViewItemStyle}" ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="RecentActivityList">
                            <ListView.ItemTemplate><DataTemplate x:DataType="presentation:RecentActivityItem">
                                <controls:RecentActivityListItem Item="{x:Bind}" HorizontalAlignment="Stretch" />
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.RecentSummary, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="RecentSummary" />
                        <HyperlinkButton Content="{x:Bind ViewModel.RecentToggleLabel, Mode=OneWay}" Click="OnToggleRecent" HorizontalAlignment="Left" Padding="0"
                                         Visibility="{x:Bind pages:ShellPage.Visible(ViewModel.CanExpandRecent), Mode=OneWay}" AutomationProperties.AutomationId="ToggleRecent" />
                    </StackPanel>
                    <StackPanel x:Name="StatisticsSection" Grid.Column="1" Spacing="16">
                        <TextBlock Text="{Binding Values[Dashboard_Usage], Source={StaticResource Strings}, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="StatisticsHeading"
                                   ToolTipService.ToolTip="{Binding Values[DashboardPage_LifetimeTotalsIncludeDeletedResourcesRankingsShowCurrent], Source={StaticResource Strings}, Mode=OneWay}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Values[DashboardPage_TotalForwards], Source={StaticResource Strings}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalForwards, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.AutomationId="TotalForwards"
                                       ToolTipService.ToolTip="{Binding Values[DashboardPage_EachNewSuccessfulForwardCountsOnceReconnectsAnd], Source={StaticResource Strings}, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Values[DashboardPage_MostUsedProfile], Source={StaticResource Strings}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MostUsedProfile.Name, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="MostUsedProfile" />
                            <TextBlock Text="{x:Bind ViewModel.MostUsedProfile.Detail, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Values[DashboardPage_AProfileUseRequiresAtLeastOneNewly], Source={StaticResource Strings}, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Values[DashboardPage_MostUsedServer], Source={StaticResource Strings}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.MostUsedServer.Name, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="MostUsedServer" />
                            <TextBlock Text="{x:Bind ViewModel.MostUsedServer.Detail, Mode=OneWay}" TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</pages:ShellPage>
