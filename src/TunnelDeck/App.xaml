<Application x:Class="TunnelDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="using:TunnelDeck.Localization">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DevWinUI/Themes/Generic.xaml" />
                <ResourceDictionary Source="Themes/DesignResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <localization:LocalizedStrings x:Key="Strings" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
