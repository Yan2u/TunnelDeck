<Window
    x:Class="TunnelDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TunnelDeck.ViewModels"
    xmlns:pages="using:TunnelDeck.Pages"
    Title="TunnelDeck">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="LayoutRoot" Loaded="OnRootLoaded" SizeChanged="OnRootSizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <DataTemplate x:Key="SearchResultTemplate" x:DataType="vm:SearchSuggestion">
                <Grid ColumnSpacing="12" Padding="4,8" AutomationProperties.Name="{x:Bind AccessibleName}" AutomationProperties.AutomationId="{x:Bind AutomationId}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="TunnelDeck" IsPaneToggleButtonVisible="True"
                  IsBackButtonVisible="{x:Bind Shell.CanGoBack, Mode=OneWay}"
                  IsBackButtonEnabled="{x:Bind Shell.CanGoBack, Mode=OneWay}"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.RightHeader>
                <Grid>
                    <AutoSuggestBox x:Name="GlobalSearch" x:Uid="GlobalSearch" Width="288" QueryIcon="Find"
                                    PlaceholderText="Search profiles and servers" UpdateTextOnSelect="False"
                                    ItemTemplate="{StaticResource SearchResultTemplate}" MaxSuggestionListHeight="400"
                                    AutomationProperties.AutomationId="GlobalSearch" AutomationProperties.Name="Search profiles and servers"
                                    TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchSubmitted" />
                    <Button x:Name="CompactSearchButton" Visibility="Collapsed" Style="{ThemeResource SubtleButtonStyle}"
                            AutomationProperties.AutomationId="CompactSearchButton" AutomationProperties.Name="Search profiles and servers"
                            ToolTipService.ToolTip="Search profiles and servers (Ctrl+K)">
                        <FontIcon Glyph="&#xE721;" />
                        <Button.Flyout>
                            <Flyout x:Name="CompactSearchFlyout" Placement="BottomEdgeAlignedRight" Opened="OnCompactSearchOpened">
                                <AutoSuggestBox x:Name="CompactSearch" Width="288" Header="Search profiles and servers" QueryIcon="Find"
                                                UpdateTextOnSelect="False" ItemTemplate="{StaticResource SearchResultTemplate}"
                                                AutomationProperties.AutomationId="CompactSearch" AutomationProperties.Name="Search profiles and servers"
                                                TextChanged="OnSearchTextChanged" SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchSubmitted" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </TitleBar.RightHeader>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" IsSettingsVisible="False" OpenPaneLength="248"
                        PaneDisplayMode="Auto" SelectionChanged="OnNavigationSelectionChanged" ItemInvoked="OnNavigationItemInvoked">
            <NavigationView.PaneHeader>
                <StackPanel>
                    <Button x:Name="DashboardButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="DashboardButton"
                            AutomationProperties.Name="Dashboard" Click="OnDashboardClick">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,4">
                            <SymbolIcon Symbol="Home" /><TextBlock Text="Dashboard" />
                        </StackPanel>
                    </Button>
                    <NavigationViewItemSeparator />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Profiles" />
                <NavigationViewItem x:Name="AllProfilesItem" Content="All profiles" Icon="Library" AutomationProperties.AutomationId="AllProfiles" />
                <NavigationViewItemHeader Content="Servers" />
                <NavigationViewItem x:Name="AllServersItem" Content="All servers" Icon="Remote" AutomationProperties.AutomationId="AllServers" />
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel>
                    <NavigationViewItemSeparator />
                    <Button x:Name="SettingsItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Style="{ThemeResource SubtleButtonStyle}" Click="OnSettingsClick"
                            AutomationProperties.AutomationId="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,4">
                            <SymbolIcon Symbol="Setting" /><TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RuntimeStatus" Text="{x:Bind Shell.RuntimeStatus, Mode=OneWay}" AutomationProperties.AutomationId="RuntimeStatus"
                               Margin="16,8,16,16" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel x:Name="Notices" Spacing="8" Margin="24,8,24,0">
                    <InfoBar x:Name="PreviewNotice" IsOpen="False" IsClosable="False" Severity="Informational"
                             Title="Design preview" Message="Sample data. No SSH connections are opened.">
                        <InfoBar.ActionButton>
                            <DropDownButton x:Name="PreviewSelector" Content="Sample"
                                      AutomationProperties.AutomationId="PreviewSelector" AutomationProperties.Name="Preview data scenario">
                                <DropDownButton.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="Sample" Tag="Sample" Click="OnPreviewChoiceClick" AutomationProperties.AutomationId="PreviewSample" />
                                    <MenuFlyoutItem Text="Long lists" Tag="Stress" Click="OnPreviewChoiceClick" AutomationProperties.AutomationId="PreviewStress" />
                                    <MenuFlyoutItem Text="Empty" Tag="Empty" Click="OnPreviewChoiceClick" AutomationProperties.AutomationId="PreviewEmpty" />
                                </MenuFlyout></DropDownButton.Flyout>
                            </DropDownButton>
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="StorageNotice" IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Loading saved data…" AutomationProperties.AutomationId="StorageNotice">
                        <InfoBar.ActionButton>
                            <Button x:Name="StorageRetry" Content="Retry" Visibility="Collapsed" Click="OnStorageRetryClick"
                                    AutomationProperties.AutomationId="StorageRetry" AutomationProperties.Name="Retry loading saved data" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="EditErrorNotice" IsOpen="{x:Bind Shell.HasError, Mode=OneWay}" Visibility="Collapsed" Severity="Error" Title="The change needs attention"
                             Message="{x:Bind Shell.Error, Mode=OneWay}" Closed="OnEditErrorClosed" AutomationProperties.AutomationId="EditError">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind Shell.DeletionRetryLabel, Mode=OneWay}" Click="OnRetryDeletion" IsEnabled="{x:Bind Shell.CanEdit, Mode=OneWay}"
                                    Visibility="{x:Bind pages:ShellPage.Visible(Shell.HasDeletionRetry), Mode=OneWay}" AutomationProperties.AutomationId="RetryDeletion" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="DeletionProgressNotice" IsOpen="{x:Bind Shell.IsDeleting, Mode=OneWay}" Visibility="Collapsed" Severity="Informational" IsClosable="False"
                             Message="{x:Bind Shell.DeletionStatus, Mode=OneWay}" AutomationProperties.AutomationId="DeletionProgress">
                        <ProgressRing IsActive="{x:Bind Shell.IsDeleting, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                    </InfoBar>
                    <InfoBar x:Name="ClosingNotice" IsOpen="False" Visibility="Collapsed" Severity="Informational" IsClosable="False"
                             Title="Closing TunnelDeck" AutomationProperties.AutomationId="ShutdownProgress">
                        <ProgressRing x:Name="ClosingProgress" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left" />
                    </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" IsNavigationStackEnabled="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
