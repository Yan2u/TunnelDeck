<pages:ShellPage
    x:Class="TunnelDeck.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages"
    xmlns:controls="using:TunnelDeck.Controls"
    xmlns:presentation="using:TunnelDeck.Core.Presentation"
    xmlns:vm="using:TunnelDeck.ViewModels"
    SizeChanged="OnPageSizeChanged">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DashboardScroll">
        <StackPanel x:Name="PageContent" Padding="24" Spacing="24">
            <TextBlock Text="Dashboard" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="DashboardPage" />
            <StackPanel x:Name="QuickForm" Spacing="12">
                <TextBlock Text="Quick forward" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                <Grid x:Name="QuickFields" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="ServerField" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="QuickServer" Header="Server" PlaceholderText="Select a server" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind Shell.ServerChoices, Mode=OneWay}" DisplayMemberPath="ChoiceLabel" SelectionChanged="OnServerSelected"
                                  IsEnabled="{x:Bind Shell.IsReady, Mode=OneWay}" AutomationProperties.AutomationId="QuickServer" AutomationProperties.Name="Quick forward server" />
                        <Button x:Name="QuickPin" Grid.Column="1" VerticalAlignment="Bottom" Style="{ThemeResource SubtleButtonStyle}" Click="OnQuickPinClick"
                                AutomationProperties.AutomationId="QuickPin" AutomationProperties.Name="Pin this server for quick forward"><FontIcon x:Name="QuickPinIcon" Glyph="&#xE718;" /></Button>
                    </Grid>
                    <controls:PortInput x:Name="QuickPort" Grid.Column="1" Header="Port" Width="128" Text="{x:Bind Shell.Quick.PortText, Mode=TwoWay}"
                                        IsEnabled="{x:Bind Shell.Quick.UseSamePort, Mode=OneWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickPort" />
                    <Button x:Name="ForwardButton" Grid.Column="2" Content="Forward" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind Shell.Quick.CanStart, Mode=OneWay}" Click="OnForwardClick" AutomationProperties.AutomationId="ForwardButton" />
                </Grid>
                <TextBlock Text="{x:Bind Shell.Quick.PortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.PortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickPortError" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Bind Shell.Quick.ServerError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.ServerError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                <RadioButtons x:Name="ForwardModeSelector" MaxColumns="2" SelectedIndex="{x:Bind Shell.Quick.ModeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="ForwardModeSelector" AutomationProperties.Name="Forwarding mode">
                    <RadioButton Content="Local forwarding" AutomationProperties.AutomationId="QuickLocalMode" />
                    <RadioButton Content="Remote forwarding" AutomationProperties.AutomationId="QuickRemoteMode" />
                </RadioButtons>
                <TextBlock Text="{x:Bind Shell.Quick.Direction, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <Grid x:Name="OptionsRow" ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <CheckBox x:Name="AutoFindPort" Content="Find next available local port if occupied" IsChecked="{x:Bind Shell.Quick.AutoFindPort, Mode=TwoWay}"
                              Visibility="{x:Bind pages:ShellPage.Visible(Shell.Quick.IsLocal), Mode=OneWay}" AutomationProperties.AutomationId="AutoFindLocalPort" />
                    <TextBlock Text="If remote listening fails, edit the port or server policy and retry." Visibility="{x:Bind pages:ShellPage.Hidden(Shell.Quick.IsLocal), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ToggleButton x:Name="AdvancedToggle" Grid.Column="1" Content="Advanced endpoints" IsChecked="{x:Bind Shell.Quick.UseAdvanced, Mode=TwoWay}" AutomationProperties.AutomationId="QuickAdvanced" />
                    <Button x:Name="QuickMore" Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="QuickMore" AutomationProperties.Name="More quick forward actions" ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="&#xE712;" />
                        <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Open terminal" IsEnabled="False" /></MenuFlyout></Button.Flyout>
                    </Button>
                </Grid>
                <Grid x:Name="AdvancedFields" Visibility="{x:Bind pages:ShellPage.Visible(Shell.Quick.UseAdvanced), Mode=OneWay}" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBox Header="{x:Bind Shell.Quick.LocalHostLabel, Mode=OneWay}" Text="{x:Bind Shell.Quick.LocalHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="QuickLocalHost" />
                    <controls:PortInput x:Name="LocalPort" Grid.Column="1" Header="Local port" Text="{x:Bind Shell.Quick.LocalPortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickLocalPort" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                        <TextBlock Text="{x:Bind Shell.Quick.LocalHostError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.LocalHostError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickLocalHostError" />
                        <TextBlock Text="{x:Bind Shell.Quick.LocalPortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.LocalPortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickLocalPortError" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Header="{x:Bind Shell.Quick.RemoteHostLabel, Mode=OneWay}" Text="{x:Bind Shell.Quick.RemoteHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="QuickRemoteHost" />
                    <controls:PortInput x:Name="RemotePort" Grid.Row="2" Grid.Column="1" Header="Remote port" Text="{x:Bind Shell.Quick.RemotePortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="QuickRemotePort" />
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                        <TextBlock Text="{x:Bind Shell.Quick.RemoteHostError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.RemoteHostError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickRemoteHostError" />
                        <TextBlock Text="{x:Bind Shell.Quick.RemotePortError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Quick.RemotePortError), Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="QuickRemotePortError" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="NoServerHint" Spacing="8">
                    <TextBlock Text="Add an SSH server to start forwarding." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton Content="Add server" Click="OnAddServerClick" HorizontalAlignment="Left" Padding="0" IsEnabled="{x:Bind Shell.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="DashboardAddServer" />
                </StackPanel>
                <TextBlock Text="Sample data. Forwarding is disabled in design preview." Visibility="{x:Bind pages:ShellPage.Visible(Shell.IsPreview), Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(Shell.Forwarding.CommandError), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Forwarding.CommandError), Mode=OneWay}" Message="{x:Bind Shell.Forwarding.CommandError, Mode=OneWay}" Severity="Error" Closed="OnCommandErrorClosed" AutomationProperties.AutomationId="ForwardCommandError" />
            <InfoBar IsOpen="{x:Bind pages:ShellPage.HasText(Shell.Forwarding.ActivityError), Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Shell.Forwarding.ActivityError), Mode=OneWay}" Message="{x:Bind Shell.Forwarding.ActivityError, Mode=OneWay}" Severity="Warning" IsClosable="False" AutomationProperties.AutomationId="ActivitySaveError">
                <InfoBar.ActionButton><Button Content="Retry saving" Click="OnRetryActivity" /></InfoBar.ActionButton>
            </InfoBar>
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Active tunnels" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Shell.RuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ActiveCount" />
                    <Button Grid.Column="2" Content="Stop all" Style="{ThemeResource SubtleButtonStyle}" IsEnabled="{x:Bind Shell.Forwarding.CanStopAll, Mode=OneWay}" Click="OnStopAll" AutomationProperties.AutomationId="StopAllTunnels" />
                </Grid>
                <StackPanel x:Name="EmptyTunnels" Spacing="8"><TextBlock Text="No active tunnels" Style="{ThemeResource BodyStrongTextBlockStyle}" /><TextBlock Text="Your active port forwards will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                <ListView x:Name="ActiveList" ItemsSource="{x:Bind Shell.Tunnels, Mode=OneWay}" SelectionMode="None" MaxHeight="360" ItemContainerStyle="{StaticResource StretchListViewItemStyle}"
                          ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ActiveTunnelList">
                    <ListView.ItemTemplate><DataTemplate x:DataType="presentation:TunnelItem">
                        <controls:TunnelListItem Item="{x:Bind}" HorizontalAlignment="Stretch" StopRequested="OnStopTunnel" RetryRequested="OnRetryTunnel" RemoveRequested="OnRemoveTunnel"
                                                 DetailsRefreshRequested="OnDetailsRefresh" OpenServerRequested="OnOpenTunnelServer" OpenProfileRequested="OnOpenTunnelProfile" />
                    </DataTemplate></ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <Grid x:Name="RecentAndStatistics" ColumnSpacing="32" RowSpacing="24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="RecentSection" Spacing="16">
                    <TextBlock Text="Recent activity" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="RecentHeading" />
                    <TextBlock x:Name="EmptyRecent" Text="Your recent forwards will appear here." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recent, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:RecentRow">
                            <Grid ColumnSpacing="12" Padding="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Route}" TextTrimming="CharacterEllipsis" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate></ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel x:Name="StatisticsSection" Grid.Column="1" Spacing="16">
                    <TextBlock Text="Statistics" Style="{ThemeResource SubtitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="StatisticsHeading" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total forwards" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalForwards, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Most used profile" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MostUsedProfile, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Most used server" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.MostUsedServer, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</pages:ShellPage>
