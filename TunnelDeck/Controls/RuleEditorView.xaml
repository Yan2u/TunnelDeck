<UserControl x:Class="TunnelDeck.Controls.RuleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TunnelDeck.Controls" xmlns:pages="using:TunnelDeck.Pages">
    <StackPanel Spacing="12">
        <ComboBox x:Name="ServerSelector" Header="Server" PlaceholderText="Select a server" HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ServerChoices, Mode=OneWay}" DisplayMemberPath="ChoiceLabel" SelectionChanged="OnServerSelected"
                  AutomationProperties.AutomationId="RuleServer" AutomationProperties.Name="Rule server" />
        <TextBlock Text="{x:Bind Model.ServerError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Model.ServerError), Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleServerError" />
        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind Model.ModeIndex, Mode=TwoWay}" AutomationProperties.Name="Rule forwarding mode">
            <RadioButton Content="Local forwarding" AutomationProperties.AutomationId="RuleLocalMode" />
            <RadioButton Content="Remote forwarding" AutomationProperties.AutomationId="RuleRemoteMode" />
        </RadioButtons>
        <TextBlock Text="{x:Bind Model.Direction, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox Header="{x:Bind Model.LocalHostLabel, Mode=OneWay}" Text="{x:Bind Model.LocalHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RuleLocalHost" />
            <controls:PortInput x:Name="LocalPort" Grid.Column="1" Header="Local port" Text="{x:Bind Model.LocalPortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="RuleLocalPort" />
            <TextBlock Grid.Row="1" Text="{x:Bind Model.LocalHostError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleLocalHostError" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Model.LocalPortError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleLocalPortError" />
        </Grid>
        <Grid ColumnSpacing="12" RowSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox Header="{x:Bind Model.RemoteHostLabel, Mode=OneWay}" Text="{x:Bind Model.RemoteHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RuleRemoteHost" />
            <controls:PortInput x:Name="RemotePort" Grid.Column="1" Header="Remote port" Text="{x:Bind Model.RemotePortText, Mode=TwoWay}" Submitted="OnPortSubmitted" AutomationProperties.AutomationId="RuleRemotePort" />
            <TextBlock Grid.Row="1" Text="{x:Bind Model.RemoteHostError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleRemoteHostError" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Model.RemotePortError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="RuleRemotePortError" />
        </Grid>
        <CheckBox Content="Find next available local port if occupied" IsChecked="{x:Bind Model.AutoFindPort, Mode=TwoWay}"
                  Visibility="{x:Bind pages:ShellPage.Visible(Model.IsLocal), Mode=OneWay}" AutomationProperties.AutomationId="RuleAutoFindLocalPort" />
        <TextBlock Text="If remote listening fails, edit the port or server policy and retry." TextWrapping="Wrap"
                   Visibility="{x:Bind pages:ShellPage.Hidden(Model.IsLocal), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorTransparentBrush}" OverflowButtonVisibility="Collapsed">
            <AppBarButton Icon="Accept" Label="Apply rule" Click="OnApplyClick" AutomationProperties.AutomationId="ApplyRule" />
            <AppBarButton Icon="Cancel" Label="Cancel rule" Click="OnCancelClick" AutomationProperties.AutomationId="CancelRule" />
        </CommandBar>
    </StackPanel>
</UserControl>
