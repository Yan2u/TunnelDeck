<UserControl
    x:Class="TunnelDeck.Controls.TunnelListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:TunnelDeck.Pages">
    <Grid ColumnSpacing="12" Padding="0,4" AutomationProperties.AutomationId="{x:Bind Item.AutomationId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.AccessibleName, Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="4" VerticalAlignment="Center">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Item.ServerName, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressRing IsActive="{x:Bind Item.IsPending, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(Item.IsPending), Mode=OneWay}" Width="16" Height="16" MinWidth="0" MinHeight="0" />
                    <TextBlock Text="{x:Bind Item.Status, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind Item.LeadingEndpoint, Mode=OneWay}" Style="{StaticResource TechnicalTextStyle}" VerticalAlignment="Center" />
                <Button Visibility="{x:Bind pages:ShellPage.Visible(Item.PortAdjusted), Mode=OneWay}" Style="{ThemeResource SubtleButtonStyle}" Padding="4" MinWidth="28" MinHeight="28"
                        AutomationProperties.AutomationId="{x:Bind Item.AdjustmentId, Mode=OneWay}" AutomationProperties.Name="Port automatically adjusted" ToolTipService.ToolTip="{x:Bind Item.Adjustment, Mode=OneWay}">
                    <InfoBadge Style="{StaticResource AttentionIconInfoBadgeStyle}"><InfoBadge.IconSource><FontIconSource Glyph="!" FontFamily="{ThemeResource ContentControlThemeFontFamily}" /></InfoBadge.IconSource></InfoBadge>
                    <Button.Flyout><Flyout><StackPanel Spacing="8" MaxWidth="320">
                        <TextBlock Text="Port adjusted" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Item.Adjustment, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                <TextBlock Text="{x:Bind Item.TrailingEndpoint, Mode=OneWay}" Style="{StaticResource TechnicalTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Item.FullRoute, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind Item.Error, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.Error), Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{x:Bind Item.ReconnectMessage, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Visible(Item.IsReconnecting), Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="{x:Bind Item.ReconnectId, Mode=OneWay}" />
            <TextBlock Text="An earlier connection request failed. Open details for the recorded error." Visibility="{x:Bind pages:ShellPage.TextVisible(Item.RequestError), Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Style="{ThemeResource SubtleButtonStyle}" IsEnabled="{x:Bind Item.CanStop, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.Hidden(Item.CanRetry), Mode=OneWay}"
                    AutomationProperties.AutomationId="{x:Bind Item.StopId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.StopName, Mode=OneWay}" ToolTipService.ToolTip="Stop forward" Click="OnStop">
                <FontIcon Glyph="&#xE71A;" />
            </Button>
            <Button Content="Retry" Visibility="{x:Bind pages:ShellPage.Visible(Item.CanRetry), Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind Item.RetryId, Mode=OneWay}" Click="OnRetry" />
            <Button Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="{x:Bind Item.DetailsId, Mode=OneWay}" AutomationProperties.Name="{x:Bind Item.DetailsName, Mode=OneWay}" ToolTipService.ToolTip="Tunnel details">
                <FontIcon Glyph="&#xE946;" />
                <Button.Flyout>
                    <Flyout x:Name="DetailsFlyout" Placement="Left" Opened="OnDetailsOpened" Closed="OnDetailsClosed">
                        <ScrollViewer MaxHeight="440" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10" MaxWidth="400">
                                <TextBlock Text="{x:Bind Item.ServerName, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Item.Mode, Mode=OneWay}" />
                                <TextBlock Text="Requested" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.RequestedRoute, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RequestedRoute" />
                                <TextBlock Text="{x:Bind Item.ActualLabel, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.FullRoute, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="ActualRoute" />
                                <TextBlock Text="Started" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Started, Mode=OneWay}" />
                                <TextBlock Text="Duration" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Duration, Mode=OneWay}" AutomationProperties.AutomationId="TunnelDuration" />
                                <TextBlock Text="Started from" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Item.Source, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="TunnelSource" />
                                <TextBlock Text="{x:Bind Item.ReconnectSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="TunnelReconnectSummary" />
                                <TextBlock Text="{x:Bind Item.ConnectionError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.ConnectionError), Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Item.RequestSummary, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Item.RequestError, Mode=OneWay}" Visibility="{x:Bind pages:ShellPage.TextVisible(Item.RequestError), Mode=OneWay}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <HyperlinkButton Content="Server" IsEnabled="{x:Bind Item.CanOpenServer, Mode=OneWay}" Click="OnOpenServer" AutomationProperties.AutomationId="OpenTunnelServer" />
                                    <HyperlinkButton Content="Profile" Visibility="{x:Bind pages:ShellPage.Visible(Item.CanOpenProfile), Mode=OneWay}" Click="OnOpenProfile" AutomationProperties.AutomationId="OpenTunnelProfile" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.AutomationId="{x:Bind Item.MoreId, Mode=OneWay}" AutomationProperties.Name="More tunnel actions" ToolTipService.ToolTip="More actions">
                <FontIcon Glyph="&#xE712;" />
                <Button.Flyout><MenuFlyout>
                    <MenuFlyoutItem Text="Retry" IsEnabled="{x:Bind Item.CanRetry, Mode=OneWay}" Click="OnRetry" />
                    <MenuFlyoutItem Text="Remove" IsEnabled="{x:Bind Item.CanRemove, Mode=OneWay}" Click="OnRemove" AutomationProperties.AutomationId="RemoveTunnel" />
                </MenuFlyout></Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
